# Brew — Safe Local Development Environment Template
# Copy to `.env` for local overrides: `cp .env.example .env`
# Never commit real API keys, tokens, or service account credentials.

# Application runtime
APP_NAME=brew
APP_ENV=local
AGENT_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS origins permitted to call FastAPI in local development (comma-separated)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurable Gemini model (defaults to gemini-3.8-flash where supported)
GEMINI_MODEL=gemini-3.8-flash

# External request safety budgets
HTTP_TIMEOUT_SECONDS=15.0
BREW_MODEL_WORKFLOW_TIMEOUT_SECONDS=60.0
HTTP_RETRY_ATTEMPTS=3

# Google Cloud / Gemini Enterprise platform configuration
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_API_USE_CLIENT_CERTIFICATE=false
# GOOGLE_OAUTH_CLIENT_ID= Google Cloud Console → APIs & Services → Credentials

# Optional: Google AI Studio API key for local prototyping (leave unset when using ADC/Vertex)
# GEMINI_API_KEY=your-api-key-placeholder

# Telemetry: set true in Cloud Run / staging / prod when Cloud Trace credentials are present
OTEL_TO_CLOUD=false

# Authentication & Identity Verification
# 'auto' uses isolated local mock personas in local/test and strictly requires verified
# Firebase / Google ID tokens in staging, production, and Cloud Run ('local_mock' is blocked there).
BREW_AUTH_MODE=auto
# FIREBASE_PROJECT_ID=your-gcp-project-id
# FIREBASE_WEB_API_KEY=your-public-firebase-web-api-key
# FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Durable persistence & ADK session storage ('in_memory' locally, 'firestore' in Cloud/emulator)
BREW_PERSISTENCE_BACKEND=in_memory
FIRESTORE_DATABASE=(default)
FIRESTORE_TIMEOUT_SECONDS=10.0
BREW_SESSION_BACKEND=auto
ADK_FIRESTORE_ROOT_COLLECTION=adk-session
# Optional local Firestore Emulator endpoint (e.g. 127.0.0.1:8085)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
