# Brew — Safe Local Development Environment Template
# Copy to `.env` for local overrides: `cp .env.example .env`
# Never commit real API keys, tokens, or service account credentials.

# Application runtime
APP_NAME=brew
APP_ENV=local
AGENT_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# CORS origins permitted to call FastAPI in local development (comma-separated)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurable Gemini model (defaults to gemini-3.8-flash where supported)
GEMINI_MODEL=gemini-3.8-flash

# External request safety budgets
HTTP_TIMEOUT_SECONDS=15.0
HTTP_RETRY_ATTEMPTS=3

# Google Cloud / Gemini Enterprise platform configuration
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Google AI Studio API key for local prototyping (leave unset when using ADC/Vertex)
# GEMINI_API_KEY=your-api-key-placeholder

# Telemetry: set true in Cloud Run / staging / prod when Cloud Trace credentials are present
OTEL_TO_CLOUD=false
